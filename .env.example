# GOFOFA server environment — copy to .env locally; set in Buddy/CloudPanel for staging/prod.
# Never commit real secrets.

# --- Required (Phase 0+) ---
# MySQL connection (server-only — never expose to the browser)
DATABASE_URL=mysql://gofofa:gofofa@127.0.0.1:3306/gofofa

# Session + magic-link signing secret (generate: openssl rand -base64 32)
AUTH_SECRET=change-me-use-openssl-rand-base64-32-min-32-chars

# Public site URL (Stripe redirects, email links)
APP_URL=http://localhost:8080

# --- Stripe (Phase 2+ — saved cards, off-session weekly charges) ---
STRIPE_SECRET_KEY=replace-with-buddy-variable
STRIPE_WEBHOOK_SECRET=replace-with-buddy-variable
STRIPE_PUBLISHABLE_KEY=replace-with-buddy-variable

# --- Email (Phase 3+ — Resend) ---
RESEND_API_KEY=replace-with-buddy-variable
RESEND_FROM_EMAIL=orders@example.com

# --- SMS (Phase 4+ — Twilio) ---
TWILIO_ACCOUNT_SID=replace-with-buddy-variable
TWILIO_AUTH_TOKEN=replace-with-buddy-variable
TWILIO_FROM_NUMBER=+15555554567

# --- Cron (Phase 4+ — protect /api/jobs/* from CloudPanel cron) ---
CRON_SECRET=change-me-use-openssl-rand-base64-24
